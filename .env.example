# Copy this file to .env and fill in real values. .env is gitignored.

# --- Azure OpenAI (Router / Change Control Clerk / Tri-Framework Workers / Chasing Agent) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_MINI_DEPLOYMENT_NAME=

# --- Misc ---
GEMINI_API_KEY=

# --- Phase 7: Real Database Integration ---
# postgresql+psycopg://<user>:<password>@<host>:5432/<db>?sslmode=require
DATABASE_URL=

# --- Phase 8: Microsoft Teams API Layer (api/main.py) ---
# From the bot's Azure Bot / Entra app registration. Leave MicrosoftAppId and
# MicrosoftAppPassword blank for purely local testing with the Bot Framework
# Emulator (anonymous/no-auth mode) -- only required once you point a real
# Azure Bot Channels Registration (and Teams) at this server.
MicrosoftAppId=
MicrosoftAppPassword=
# SingleTenant is Microsoft's current recommendation (MultiTenant bot
# creation is being phased out); MultiTenant/UserAssignedMSI are also valid.
MicrosoftAppType=SingleTenant
# Required for MicrosoftAppType=SingleTenant or UserAssignedMSI; leave blank
# for MultiTenant.
MicrosoftAppTenantId=
